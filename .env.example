# REDIS instance
REDIS_BROKER_URI=redis://redis:6379/0

# Set to 'false' to disable the embedded Celery worker (use when running standalone workers)
USE_EMBEDDED_CELERY_WORKER=true

# Primary PostgreSQL Server
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Timescale/Secondary PostgreSQL Server (Optional)
# If a database is not found on the primary server, the service will try the Timescale server
# POSTGRES_TIMESCALE_HOST=localhost
# POSTGRES_TIMESCALE_PORT=5433

# API Configuration
# ROOT_PATH is used when the API is behind a reverse proxy
# ROOT_PATH=

# Local path where CSV source files are stored (used by the CSV data source)
# S3_MOUNT_PATH=/mnt/s3

# LLM API Configuration (must be OpenAI compatible)
# Base URL for the LLM API (e.g., OpenAI, Anthropic, or a self-hosted solution)
LLM_API_BASE=
# API key for authenticating with the LLM API (optional)
LLM_API_KEY=
# Model name to use in litellm format (e.g., "openai/gpt-4" or "ollama/llama3.1")
LLM_API_MODEL=
# Set to 'false' to disable SSL verification (useful for self-signed certificates)
LLM_SSL_VERIFY=true

# AUTH configuration
OIDC_ISSUER=
OIDC_AUDIENCE=
JWKS_TTL_SECONDS=300
PERMISSIONS_GATEWAY_URL=